<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>netstandard2.1</TargetFramework>
    <LangVersion>latest</LangVersion>
    <RootNamespace>Rochas.BWOQ</RootNamespace>
    <AssemblyName>Rochas.BWOQ</AssemblyName>
    <GeneratePackageOnBuild>true</GeneratePackageOnBuild>
    <Authors>Renato Rocha</Authors>
    <Copyright>Renato Rocha</Copyright>
    <Description>Rochas BWOQ - BitWise Object Query for compact query composition</Description>
    <PackageTags>linq dynamic query bitwise elastic search rochas bwoq sql ansi repository dapper</PackageTags>    <PackageReadmeFile>README.md</PackageReadmeFile>
    <PackageLicenseFile>GNUv2_License.txt</PackageLicenseFile>
    <Version>1.6.3</Version>
    <PackageReleaseNotes>v1.6.3 (data-toolkit): dependencias migradas para Rochas.Data.Specification 2.0.0 (namespace Rochas.Data.Specification.*) e Rochas.SqlWrapper 1.1.2. Sem mudanca de comportamento.</PackageReleaseNotes>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\DataSpecification\Rochas.Data.Specification\Rochas.Data.Specification.csproj" />
    <ProjectReference Include="..\..\SqlWrapper\Rochas.SqlWrapper\Rochas.SqlWrapper.csproj" />
    <PackageReference Include="System.ComponentModel.Annotations" Version="5.0.0" />
    <PackageReference Include="System.Linq.Dynamic.Core" Version="1.7.3" />
    <PackageReference Include="System.Text.Json" Version="8.0.5" />
    
  </ItemGroup>

  <ItemGroup>
    <None Include="..\README.md" Pack="true" PackagePath="\" />
  </ItemGroup>

  <ItemGroup>
    <None Include="GNUv2_License.txt">
      <Pack>True</Pack>
      <PackagePath></PackagePath>
    </None>
  </ItemGroup>

</Project>
