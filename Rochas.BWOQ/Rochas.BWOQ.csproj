<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>netstandard2.1</TargetFramework>
    <LangVersion>latest</LangVersion>
    <RootNamespace>Rochas.BWOQ</RootNamespace>
    <AssemblyName>Rochas.BWOQ</AssemblyName>
    <GeneratePackageOnBuild>true</GeneratePackageOnBuild>
    <Authors>Renato Rocha</Authors>
    <Copyright>Renato Rocha</Copyright>
    <RepositoryType>Git</RepositoryType>
    <RepositoryUrl>https://github.com/rocha83/BWOQ</RepositoryUrl>
    <PackageProjectUrl>https://github.com/rocha83/BWOQ</PackageProjectUrl>
    <Description>Rochas BWOQ - BitWise Object Query for compact query composition</Description>
    <PackageTags>linq dynamic query bitwise elastic search rochas bwoq sql ansi repository dapper</PackageTags>    <PackageReadmeFile>README.md</PackageReadmeFile>
    <PackageLicenseFile>GNUv2_License.txt</PackageLicenseFile>
    <Version>1.6.6</Version>
    <PackageReleaseNotes>v1.6.6 - Rochas.SqlWrapper 1.4.8 -> 1.4.9 (DateOnly/TimeOnly as quoted ISO literals). v1.6.5 - Rochas.SqlWrapper 1.1.2 -> 1.4.8 (GROUP BY válido no PostgreSQL + EntityReflector com cache). v1.6.4 - Dependencies migrated to Rochas.Data.Specification and Rochas.SqlWrapper. No behavior change.</PackageReleaseNotes>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Rochas.Data.Specification" Version="1.6.3" />
    <PackageReference Include="Rochas.SqlWrapper" Version="1.4.9" />
    <PackageReference Include="System.ComponentModel.Annotations" Version="5.0.0" />
    <PackageReference Include="System.Linq.Dynamic.Core" Version="1.7.3" />
    <PackageReference Include="System.Text.Json" Version="8.0.5" />
    
  </ItemGroup>

  <ItemGroup>
    <None Include="..\README.md" Pack="true" PackagePath="\" />
  </ItemGroup>

  <ItemGroup>
    <None Include="GNUv2_License.txt">
      <Pack>True</Pack>
      <PackagePath></PackagePath>
    </None>
  </ItemGroup>

</Project>
